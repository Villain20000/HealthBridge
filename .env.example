# ---------------------------------------------------------------------------
# HealthBridge OS — API configuration
# Copy to .env and fill in. The API refuses to start in production without a
# database and a key pepper; that is deliberate, not a bug (see docs/api.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Durable persistence. Without this the API runs in in-memory demo mode and
# loses everything on restart.
# DATABASE_URL=mysql://healthbridge:change-me@127.0.0.1:3306/healthbridge

# Mixed into every API key hash. Rotating it invalidates every issued key.
HEALTHBRIDGE_KEY_PEPPER=replace-with-at-least-16-random-characters
# Required with a database: the only way to create the first workspace.
# Must be at least 16 characters; use a long random value (e.g. openssl rand -base64 24).
HEALTHBRIDGE_BOOTSTRAP_TOKEN=replace-with-a-random-token
# Public POST /api/v1/workspaces attempts allowed per client IP in a 15-minute
# window (default 10). Failed attempts count too.
HEALTHBRIDGE_BOOTSTRAP_RATE_LIMIT=10

# Object storage for uploaded files (content-addressed on disk).
HEALTHBRIDGE_STORAGE_DIR=./.data/objects
HEALTHBRIDGE_MAX_UPLOAD_BYTES=67108864
HEALTHBRIDGE_MAX_BODY_BYTES=1048576

# Limits
HEALTHBRIDGE_RATE_LIMIT_BURST=120
HEALTHBRIDGE_RATE_LIMIT_RPS=20
HEALTHBRIDGE_MAX_STORED_RESULT_BYTES=5242880
HEALTHBRIDGE_MAX_TRACES_PER_RUN=5000
HEALTHBRIDGE_QUEUE_CONCURRENCY=2
HEALTHBRIDGE_QUEUE_MAX_ATTEMPTS=2
HEALTHBRIDGE_SSE_HEARTBEAT_MS=15000
# The console is served same-origin and proxies /api/*, so CORS is only needed for
# direct cross-origin API callers. Native console fetches need no CORS entry.
HEALTHBRIDGE_CORS_ORIGINS=http://localhost:4200

# --- Operator Console (apps/web/server.mjs) ---
# Host port for the compose stack; the UI is at http://127.0.0.1:${WEB_PORT}.
WEB_PORT=4200
# 0 disables the upstream socket timeout, which is what keeps SSE connections open.
PROXY_TIMEOUT_MS=0
# Set to 1 when TLS terminates in front of the web container (adds HSTS).
TRUST_PROXY=0

# Queue (database mode): one row per run in `run_jobs`.
# HEARTBEAT: how often a replica looks for claimable work.
HEALTHBRIDGE_QUEUE_POLL_MS=500
# A claim older than this is treated as a dead worker and re-claimed.
HEALTHBRIDGE_QUEUE_VISIBILITY_MS=300000
HEALTHBRIDGE_QUEUE_CONCURRENCY=2
HEALTHBRIDGE_QUEUE_MAX_ATTEMPTS=2
