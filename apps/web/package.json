{
  "name": "@healthbridge/web",
  "version": "3.2.0",
  "description": "HealthBridge Operator Console (Angular, standalone + signals). Static landing page and /api proxy are gone: this is the real UI.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "node ../../scripts/run-tests.mjs \"apps/web/test/*.test.ts\""
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@healthbridge/shared-types": "3.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
