# Operator Console image: Angular build + one static/proxy Node process.
#
# The runtime stage copies only the built bundle and `server.mjs`, which uses Node built-ins
# exclusively — that is why `npm prune --omit=dev` is safe here.
FROM node:25-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
RUN npm ci
RUN npm run build
RUN npm run build:web

FROM node:25-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=4200 \
    API_PREFIX=/api \
    PROXY_TIMEOUT_MS=0
COPY --from=builder /app/apps/web/server.mjs ./server.mjs
COPY --from=builder /app/apps/web/dist/web/browser ./dist/web/browser
USER node
EXPOSE 4200
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4200)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
